---
// AIM holding page — content to come.
import Base from '../layouts/Base.astro';
---

<Base
  title="AIM — Audience Impact Model"
  description="AIM, the Audience Impact Model — a framework for setting goals, designing and evaluating experiences that create meaningful connection, learning and impact."
>
  <main class="aim">
    <div class="aimtitlebox" id="aimtitlebox"><h1 id="aimtitle">AIM</h1></div>
    <h2 class="slashes">audience/impact/model</h2>
    <p class="blurb">A framework for setting goals, designing and evaluating
    experiences that create meaningful connection, learning and impact.</p>
    <p class="soon">MORE SOON</p>
    <nav>
      <a href="/">cultural/digital/insight</a>
      <a href="mailto:info@culturaldigitalinsight.nz">info@culturaldigitalinsight.nz</a>
    </nav>
  </main>
</Base>

<style>
  .aim {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    padding: 32px 24px;
  }

  /* Fixed-height box (sized by script to the tallest font) so the content
     below doesn't shift as the cycle moves between fonts — same technique
     as the homepage wordmark. */
  .aimtitlebox {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    overflow-x: clip;   /* wide side-bearings must never trigger page scroll */
  }

  h1 {
    margin: 0;
    font-weight: 400;
    white-space: nowrap;
    line-height: 1.1;
    visibility: hidden;              /* shown by script once fonts are measured */
  }
  h1:global(.ready) { visibility: visible; }

  .slashes {
    margin: 0;
    font-family: 'Silkscreen', monospace;
    font-weight: 400;
    font-size: clamp(21px, 3.9vw, 30px);
    letter-spacing: 1px;
  }

  .blurb {
    margin: 0;
    max-width: 440px;
    font-size: 17px;
    line-height: 1.65;
  }

  .soon {
    margin: 8px 0 0;
    font-family: 'Bitcount Single', monospace;
    font-size: clamp(13px, 2.2vw, 18px);
    letter-spacing: 3px;
  }

  nav {
    margin-top: 6vh;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
</style>

<script is:inline>
  const FONTS = [
    "'Silkscreen', monospace",
    "'Bitcount Single', monospace",
    "'Atomic Age', serif",
    "'Tourney', sans-serif",
  ];
  const title = document.getElementById('aimtitle');
  const titlebox = document.getElementById('aimtitlebox');
  const ctx = document.createElement('canvas').getContext('2d');
  const sizes = [];     // per-font font-size (px) that makes the INK of "AIM" hit the target width
  const shiftsX = [];   // per-font translateX (px) that centres the ink, not the layout box
  const shiftsY = [];   // per-font translateY (px) that centres the ink vertically too

  // Fonts carry different side bearings and baseline positions (built-in space
  // around the glyphs), so fitting/centring by layout box still lets the drawn
  // letters wander. Canvas ink metrics measure the actual drawn edges instead,
  // and both axes get a per-font correction.
  function fit() {
    // "AIM" is only three glyphs — cap the target well below the viewport so
    // side bearings can't push the layout box past the page edge on mobile.
    const target = Math.min(window.innerWidth * 0.8, 440);
    let titleH = 0;
    FONTS.forEach((font, i) => {
      ctx.font = '100px ' + font;
      const m = ctx.measureText(title.textContent);
      const inkW = m.actualBoundingBoxLeft + m.actualBoundingBoxRight;
      sizes[i] = inkW > 0 ? 100 * target / inkW : 16;
      const s = sizes[i] / 100;
      // Horizontal: offset between the ink's centre and the layout box's centre.
      const inkCentreX = (m.actualBoundingBoxRight - m.actualBoundingBoxLeft) / 2;
      shiftsX[i] = -(inkCentreX - m.width / 2) * s;
      // Vertical: where the ink's centre sits inside the line box (half-leading
      // model puts the baseline via the font's bounding-box metrics).
      const lineH = sizes[i] * 1.1;   /* matches the h1's line-height */
      const fbA = (m.fontBoundingBoxAscent ?? m.actualBoundingBoxAscent) * s;
      const fbD = (m.fontBoundingBoxDescent ?? m.actualBoundingBoxDescent) * s;
      const baseline = (lineH - (fbA + fbD)) / 2 + fbA;
      const inkCentreY = baseline + (m.actualBoundingBoxDescent - m.actualBoundingBoxAscent) * s / 2;
      shiftsY[i] = lineH / 2 - inkCentreY;
      titleH = Math.max(titleH, (m.actualBoundingBoxAscent + m.actualBoundingBoxDescent) * s);
    });
    titlebox.style.height = Math.ceil(titleH * 1.08) + 'px';
  }

  let current = 0;
  function show(i) {
    title.style.fontFamily = FONTS[i];
    title.style.fontSize = sizes[i] + 'px';
    title.style.transform = 'translate(' + shiftsX[i].toFixed(1) + 'px,' + shiftsY[i].toFixed(1) + 'px)';
  }

  // Load every face before measuring (document.fonts.ready alone can resolve
  // before lazily-loaded fonts start downloading).
  Promise.all(
    FONTS.map((f) => document.fonts.load('100px ' + f, title.textContent))
  ).catch(() => {}).then(() => {
    fit();
    show(0);
    title.classList.add('ready');
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        current = (current + 1) % FONTS.length;
        show(current);
      }, 1000);
    }
  });

  document.fonts.addEventListener('loadingdone', () => { fit(); show(current); });
  addEventListener('resize', () => { fit(); show(current); });
</script>
