---
// Landing page: white cycling-font wordmark on black, plus About.
// The fitting/cycling script is is:inline — Astro serves it untouched.
import Base from '../layouts/Base.astro';
---

<Base
  title="cultural/digital/insight"
  description="C/D/I — a consultancy helping organisations navigate audiences, community, impact and evaluation in relation to cultural digital experiences."
>
  <section class="hero">
    <div class="titlebox" id="titlebox"><h1 id="title">cultural/digital/insight</h1></div>
    <div class="mailbox" id="mailbox"><a id="mail" href="mailto:info@culturaldigitalinsight.nz">info@culturaldigitalinsight.nz</a></div>
  </section>

  <section class="about">
    <h2>ABOUT C/D/I</h2>
    <p>C/D/I is a consultancy to help organisations understand how to navigate
    audiences, community, impact and evaluation in relation to cultural digital
    experiences.</p>
    <p>Adrian Kingston has over 25 years working with national cultural
    organisations here in Aotearoa, and advising internationally. The creator of
    the Audience Impact Model (AIM), a framework for setting goals, designing and
    evaluating experiences that create meaningful connection, learning and impact
    for different audiences and communities.</p>
    <p class="linkedin">
      <a href="https://www.linkedin.com/in/adriankingston/" rel="noopener">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
        <span>linkedin.com/in/adriankingston</span>
      </a>
    </p>
  </section>

  <span id="measure" aria-hidden="true">cultural/digital/insight</span>
</Base>

<style>
  /* Full-viewport hero: the cycling wordmark + email, centred. */
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6vh;
  }

  /* Fixed-height boxes (sized by script to the tallest font) so the layout
     doesn't shift vertically as the cycle moves between fonts of different
     heights — each element just re-centres inside its own box. */
  .titlebox, .mailbox {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  h1 {
    margin: 0;
    font-weight: 400;
    white-space: nowrap;
    line-height: 1.1;
    visibility: hidden;              /* shown by script once fonts are measured */
  }
  h1:global(.ready) { visibility: visible; }

  .about {
    max-width: 560px;
    margin: 0 auto;
    padding: 0 24px 14vh;
  }
  .about h2 {
    margin: 0 0 32px;
    font-family: 'Silkscreen', monospace;
    font-weight: 400;
    font-size: clamp(15px, 2.4vw, 20px);
    letter-spacing: 2px;
  }
  .about p {
    margin: 0 0 20px;
    text-align: left;
    font-size: 17px;
    line-height: 1.65;
  }
  .about .linkedin {
    margin: 36px 0 0;
    text-align: center;
  }
  .about .linkedin a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .about .linkedin svg { flex: none; }

  /* Off-screen measuring element: same text, one font at a time. */
  #measure {
    position: absolute;
    left: -9999px;
    top: 0;
    font-size: 100px;
    white-space: nowrap;
    visibility: hidden;
  }
</style>

<script is:inline>
  const FONTS = [
    "'Silkscreen', monospace",
    "'Bitcount Single', monospace",
    "'Atomic Age', serif",
    "'Tourney', sans-serif",
  ];
  const title = document.getElementById('title');
  const titlebox = document.getElementById('titlebox');
  const mail = document.getElementById('mail');
  const mailbox = document.getElementById('mailbox');
  const measure = document.getElementById('measure');
  const sizes = [];   // per-font font-size (px) that makes the text 90% of viewport width

  function fit() {
    const target = window.innerWidth * 0.9;
    let titleH = 0;
    FONTS.forEach((font, i) => {
      measure.style.fontFamily = font;
      measure.style.fontSize = '100px';
      measure.textContent = title.textContent;
      const r = measure.getBoundingClientRect();
      sizes[i] = r.width > 0 ? 100 * target / r.width : 16;
      titleH = Math.max(titleH, r.height * sizes[i] / 100);
    });
    // Boxes take the tallest font's height so the layout never shifts.
    titlebox.style.height = Math.ceil(titleH * 1.1) + 'px';
    let mailH = 0;
    const mailSize = parseFloat(getComputedStyle(mail).fontSize);
    FONTS.forEach((font) => {
      measure.style.fontFamily = font;
      measure.style.fontSize = mailSize + 'px';
      measure.textContent = mail.textContent;
      mailH = Math.max(mailH, measure.getBoundingClientRect().height);
    });
    mailbox.style.height = Math.ceil(mailH * 1.4) + 'px';
  }

  let current = 0;
  function show(i) {
    title.style.fontFamily = FONTS[i];
    title.style.fontSize = sizes[i] + 'px';
    mail.style.fontFamily = FONTS[(i + FONTS.length - 1) % FONTS.length];   // one step behind the title
  }

  // Explicitly load every face before measuring — document.fonts.ready alone
  // can resolve before lazily-loaded fonts start downloading, which would
  // make fit() measure the fallback fonts and compute the wrong sizes.
  Promise.all(
    FONTS.map((f) => document.fonts.load('100px ' + f, title.textContent))
  ).catch(() => {}).then(() => {
    fit();
    show(0);
    title.classList.add('ready');
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        current = (current + 1) % FONTS.length;
        show(current);
      }, 1000);
    }
  });

  // Safety net: if any face arrives after first paint, re-measure.
  document.fonts.addEventListener('loadingdone', () => { fit(); show(current); });

  addEventListener('resize', () => { fit(); show(current); });
</script>
